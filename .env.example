# 复制本文件为 .env 并填入自己的配置（.env 已被 .gitignore 排除）

# NCBI Entrez API Key（必填，免费）
# 申请：https://www.ncbi.nlm.nih.gov/account/ → Account Settings → API Key Management
NCBI_API_KEY=your_ncbi_api_key_here

# 联系邮箱（建议填）
# NCBI 的 E-utilities 使用规范要求每个请求带 tool 与 email：出现异常流量时，
# 他们据此先联系你，而不是直接限流或封 IP。不填只会在日志里警告一次。
NCBI_EMAIL=

# Semantic Scholar API Key（可选，免费；给 `cli.py citations` 用）
# 不填也能跑，但走的是所有匿名用户共享的限速池，几百篇要跑很久。
# 申请：https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# Unpaywall 联系邮箱（可选；给 `cli.py pdf --fetch` 用）
# 填了会多一条 OA 全文来源（Unpaywall 的 best OA 直链）；不填就只走 PMC 那条路。
# 不需要注册，随便一个能收信的邮箱即可——他们只用它做用量联系。
UNPAYWALL_EMAIL=

# DeepL API Key（可选；不填则标题不翻译成中文，其余功能正常）
# 申请：https://www.deepl.com/pro-api
DEEPL_API_KEY=

# Obsidian 导出目录（可选；不填则 `cli.py obsidian` 不可用，其余功能正常）
# 填 vault 里存放文献笔记的那个文件夹的绝对路径
OBSIDIAN_DIR=

# 收藏库本地服务端口（可选，默认 8781）
# 若与本机其它服务冲突请改——冲突时请求可能被对方接走，导致误改别的数据库
LITTRACK_PORT=8781

# 走系统/环境里的代理（可选，默认不走）
# 本工具默认**绕开**代理：本地代理（Clash 之类常驻 127.0.0.1:7890）一抖动就表现为
# NameResolutionError / SSLEOFError，整轮检索失败，而报错完全看不出跟代理有关；
# 出版商对机场、数据中心 IP 的反爬也更严，抓 OA 全文的命中率会更低。
# NCBI / DeepL / Semantic Scholar 直连可达。只有「公司网络只开代理出口」这类情况
# 才需要填 1 要回原来的行为。
LITTRACK_USE_PROXY=
